{
  "name": "quoter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply quoter-db --local",
    "db:seed": "wrangler d1 execute quoter-db --local --file seed.sql",
    "typecheck": "tsc -b",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:api": "node tests/api-smoke.mjs",
    "account:import-demo": "node scripts/import-demo.mjs",
    "test:auth": "node tests/auth-smoke.mjs",
    "test:email": "node tests/email-smoke.mjs",
    "test:business": "node tests/business-smoke.mjs",
    "test:data": "node tests/data-smoke.mjs",
    "test:ui": "node tests/browser-smoke.mjs",
    "test:plans": "node tests/plans-smoke.mjs"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.149.0"
  }
}
