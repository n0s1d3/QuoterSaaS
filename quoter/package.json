{
  "name": "quoter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply quoter-db --local",
    "db:seed": "wrangler d1 execute quoter-db --local --file seed.sql",
    "typecheck": "tsc -b",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:api": "node tests/api-smoke.mjs",
    "account:import-demo": "node scripts/import-demo.mjs",
    "test:auth": "node tests/auth-smoke.mjs",
    "test:email": "node tests/email-smoke.mjs",
    "test:business": "node tests/business-smoke.mjs",
    "test:data": "node tests/data-smoke.mjs",
    "test:ui": "node tests/browser-smoke.mjs",
    "test:plans": "node tests/plans-smoke.mjs",
    "plan:activate": "node scripts/activate-plan.mjs",
    "test:activation": "node tests/activation-smoke.mjs",
    "test:customer-import": "node tests/customer-import-smoke.mjs",
    "test:subscription": "node tests/subscription-smoke.mjs",
    "test:subscription-ui": "node tests/subscription-browser.mjs",
    "admin:master": "node scripts/admin-master.mjs",
    "test:admin": "node tests/platform-admin-smoke.mjs",
    "test:security": "node tests/security-smoke.mjs",
    "test:mfa": "node tests/mfa-smoke.mjs",
    "admin:reset-mfa": "node scripts/reset-admin-mfa.mjs",
    "mfa:setup": "node scripts/configure-local-mfa.mjs",
    "test:hardening": "node tests/hardening-smoke.mjs",
    "password:setup": "node scripts/configure-password-pepper.mjs",
    "password:provision": "node scripts/provision-password-pepper.mjs",
    "backup:key": "node scripts/db-recovery.mjs key",
    "backup:db": "node scripts/db-recovery.mjs backup",
    "backup:drill": "node scripts/db-recovery.mjs drill",
    "check:production": "node scripts/check-production.mjs",
    "test:recovery": "node tests/recovery-smoke.mjs"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "miniflare": "5.20261006.1-alpha",
    "oxlint": "^1.81.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.149.0"
  }
}
